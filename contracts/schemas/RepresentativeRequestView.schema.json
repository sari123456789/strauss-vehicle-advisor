{
  "$defs": {
    "EntitlementGroup": {
      "description": "Source Hebrew group labels are preserved as values.",
      "enum": [
        "א",
        "ב",
        "ג",
        "ד"
      ],
      "title": "EntitlementGroup",
      "type": "string"
    },
    "ExpectedValueType": {
      "enum": [
        "money",
        "entitlement_group",
        "propulsion",
        "tax_key",
        "boolean",
        "text"
      ],
      "title": "ExpectedValueType",
      "type": "string"
    },
    "HandlingStatus": {
      "description": "Assignment ownership as seen by the current representative — derived, not stored.",
      "enum": [
        "unclaimed",
        "assigned_to_me",
        "assigned_to_other",
        "completed"
      ],
      "title": "HandlingStatus",
      "type": "string"
    },
    "RepresentativeFieldCode": {
      "description": "Server-recognized facts a representative may supply (provisional allowlist).",
      "enum": [
        "alternative.participation",
        "occupation.waiverPolicy",
        "employee.entitlementGroup",
        "currentArrangement.propulsion",
        "currentArrangement.vehicle",
        "general.question"
      ],
      "title": "RepresentativeFieldCode",
      "type": "string"
    },
    "RequestEmployeeView": {
      "additionalProperties": false,
      "description": "Who the request is about, for the handling representative (decision 23). Never salary,\npayroll or other profile values.",
      "properties": {
        "currentVehicle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currentvehicle"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "employeeCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employeecode"
        },
        "occupation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupation"
        }
      },
      "title": "RequestEmployeeView",
      "type": "object"
    },
    "RequestStatus": {
      "enum": [
        "open",
        "answered",
        "cannot_determine",
        "cancelled"
      ],
      "title": "RequestStatus",
      "type": "string"
    },
    "VehicleContext": {
      "additionalProperties": false,
      "properties": {
        "catalogueId": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2,5}-\\d{2,4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalogueid"
        },
        "commercialName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commercialname"
        },
        "registrationYear": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registrationyear"
        }
      },
      "title": "VehicleContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Representative-visible, minimal context only (no employee profile or salary).\n\nBackward-compatible: all new fields are Optional with safe defaults so existing\nAngular consumers continue to work without changes.",
  "properties": {
    "assignmentVersion": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assignmentversion"
    },
    "canAnswer": {
      "default": false,
      "title": "Cananswer",
      "type": "boolean"
    },
    "canClaim": {
      "default": false,
      "title": "Canclaim",
      "type": "boolean"
    },
    "canRelease": {
      "default": false,
      "title": "Canrelease",
      "type": "boolean"
    },
    "claimedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimedat"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "employee": {
      "anyOf": [
        {
          "$ref": "#/$defs/RequestEmployeeView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entitlementGroup": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntitlementGroup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expectedValueType": {
      "$ref": "#/$defs/ExpectedValueType"
    },
    "fieldCode": {
      "$ref": "#/$defs/RepresentativeFieldCode"
    },
    "handlerDisplayName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Handlerdisplayname"
    },
    "handlingStatus": {
      "anyOf": [
        {
          "$ref": "#/$defs/HandlingStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "questionText": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Questiontext",
      "type": "string"
    },
    "requestId": {
      "format": "uuid",
      "title": "Requestid",
      "type": "string"
    },
    "requestVersion": {
      "minimum": 0,
      "title": "Requestversion",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RequestStatus"
    },
    "updatedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updatedat"
    },
    "vehicle": {
      "anyOf": [
        {
          "$ref": "#/$defs/VehicleContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "requestId",
    "requestVersion",
    "status",
    "fieldCode",
    "expectedValueType",
    "questionText",
    "createdAt"
  ],
  "title": "RepresentativeRequestView",
  "type": "object"
}
