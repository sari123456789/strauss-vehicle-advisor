{
  "$defs": {
    "FieldPath": {
      "description": "Allowlisted fields of the actual EmployeeProfile / case working state.",
      "enum": [
        "payroll.baseGross",
        "payroll.commissionsGross",
        "payroll.bonusGross",
        "payroll.pensionEmployeeRate",
        "payroll.studyFundEmployeeRate",
        "payroll.creditPoints",
        "employee.occupationId",
        "employee.entitlementGroup",
        "employee.qualifyingChildrenCount",
        "currentArrangement.kind",
        "currentArrangement.vehicle",
        "currentArrangement.propulsion",
        "currentArrangement.participation",
        "currentArrangement.familyDeduction",
        "currentArrangement.familyDeductionIncludedInParticipation",
        "currentArrangement.allowance"
      ],
      "title": "FieldPath",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "description": "A business-level observation. Never contains raw exceptions or salary documents.",
      "properties": {
        "code": {
          "$ref": "#/$defs/IssueCode"
        },
        "field": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "optionKey": {
          "anyOf": [
            {
              "pattern": "^(vehicle:[A-Z]{2,5}-\\d{2,4}|waiver)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optionkey"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "requestId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requestid"
        }
      },
      "required": [
        "code"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueCode": {
      "enum": [
        "MISSING_INPUT",
        "AMBIGUOUS_INPUT",
        "INELIGIBLE",
        "VEHICLE_NOT_FOUND",
        "TAX_KEY_AMBIGUOUS",
        "SOURCE_CONFLICT",
        "STALE_REVISION",
        "PENDING_REPRESENTATIVE",
        "TOOL_UNAVAILABLE",
        "UNSUPPORTED_INPUT"
      ],
      "title": "IssueCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confirmedFields": {
      "items": {
        "$ref": "#/$defs/FieldPath"
      },
      "title": "Confirmedfields",
      "type": "array"
    },
    "newCaseVersion": {
      "minimum": 0,
      "title": "Newcaseversion",
      "type": "integer"
    },
    "newProfileVersion": {
      "minimum": 0,
      "title": "Newprofileversion",
      "type": "integer"
    },
    "notConfirmable": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Notconfirmable",
      "type": "array"
    }
  },
  "required": [
    "confirmedFields",
    "newCaseVersion",
    "newProfileVersion"
  ],
  "title": "ConfirmProfileFieldsResult",
  "type": "object"
}
