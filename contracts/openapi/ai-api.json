{
  "components": {
    "schemas": {
      "ConversationDetail": {
        "additionalProperties": false,
        "properties": {
          "conversation": {
            "$ref": "#/components/schemas/ConversationSummary"
          },
          "history": {
            "$ref": "#/components/schemas/MessagePage"
          }
        },
        "required": [
          "conversation",
          "history"
        ],
        "title": "ConversationDetail",
        "type": "object"
      },
      "ConversationList": {
        "additionalProperties": false,
        "properties": {
          "conversations": {
            "items": {
              "$ref": "#/components/schemas/ConversationSummary"
            },
            "title": "Conversations",
            "type": "array"
          }
        },
        "required": [
          "conversations"
        ],
        "title": "ConversationList",
        "type": "object"
      },
      "ConversationSummary": {
        "additionalProperties": false,
        "properties": {
          "calculationMonth": {
            "title": "Calculationmonth",
            "type": "string"
          },
          "caseId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Caseid"
          },
          "conversationId": {
            "format": "uuid",
            "title": "Conversationid",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "conversationId",
          "caseId",
          "status",
          "calculationMonth"
        ],
        "title": "ConversationSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InputStatus": {
        "additionalProperties": false,
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "inputId": {
            "format": "uuid",
            "title": "Inputid",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageView"
            },
            "title": "Messages",
            "type": "array"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "inputId",
          "sequence",
          "status",
          "attempts",
          "messages"
        ],
        "title": "InputStatus",
        "type": "object"
      },
      "MessagePage": {
        "additionalProperties": false,
        "properties": {
          "hasMore": {
            "title": "Hasmore",
            "type": "boolean"
          },
          "lastSequence": {
            "title": "Lastsequence",
            "type": "integer"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageView"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "messages",
          "lastSequence",
          "hasMore"
        ],
        "title": "MessagePage",
        "type": "object"
      },
      "MessageView": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "inputId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inputid"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "messageId": {
            "format": "uuid",
            "title": "Messageid",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "messageId",
          "sequence",
          "role",
          "kind",
          "text",
          "payload",
          "inputId",
          "createdAt"
        ],
        "title": "MessageView",
        "type": "object"
      },
      "StartConversationRequest": {
        "additionalProperties": false,
        "properties": {
          "calculationMonth": {
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Calculationmonth",
            "type": "string"
          },
          "clientRequestId": {
            "format": "uuid",
            "title": "Clientrequestid",
            "type": "string"
          }
        },
        "required": [
          "clientRequestId",
          "calculationMonth"
        ],
        "title": "StartConversationRequest",
        "type": "object"
      },
      "SubmitMessageRequest": {
        "additionalProperties": false,
        "properties": {
          "messageId": {
            "format": "uuid",
            "title": "Messageid",
            "type": "string"
          },
          "text": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "messageId",
          "text"
        ],
        "title": "SubmitMessageRequest",
        "type": "object"
      },
      "SubmitMessageResponse": {
        "additionalProperties": false,
        "properties": {
          "duplicate": {
            "title": "Duplicate",
            "type": "boolean"
          },
          "inputId": {
            "format": "uuid",
            "title": "Inputid",
            "type": "string"
          },
          "messageId": {
            "format": "uuid",
            "title": "Messageid",
            "type": "string"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": [
          "inputId",
          "messageId",
          "sequence",
          "duplicate"
        ],
        "title": "SubmitMessageResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Access token from /api/v1/auth/login",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Strauss Vehicle Advisor - Conversation API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/conversations": {
      "get": {
        "operationId": "list_conversations_api_v1_conversations_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Conversations",
        "tags": [
          "conversations"
        ]
      },
      "post": {
        "operationId": "start_conversation_api_v1_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartConversationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Start Conversation",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/v1/conversations/{conversationId}": {
      "delete": {
        "description": "Removes the conversation from the employee's list; its history is kept.",
        "operationId": "delete_conversation_api_v1_conversations__conversationId__delete",
        "parameters": [
          {
            "in": "path",
            "name": "conversationId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversationid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Conversation",
        "tags": [
          "conversations"
        ]
      },
      "get": {
        "operationId": "get_conversation_api_v1_conversations__conversationId__get",
        "parameters": [
          {
            "in": "path",
            "name": "conversationId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversationid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Conversation",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/v1/conversations/{conversationId}/inputs/{inputId}": {
      "get": {
        "operationId": "get_input_api_v1_conversations__conversationId__inputs__inputId__get",
        "parameters": [
          {
            "in": "path",
            "name": "conversationId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversationid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "inputId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Inputid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Input",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/v1/conversations/{conversationId}/messages": {
      "get": {
        "operationId": "poll_messages_api_v1_conversations__conversationId__messages_get",
        "parameters": [
          {
            "in": "path",
            "name": "conversationId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversationid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "afterSequence",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Aftersequence",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Poll Messages",
        "tags": [
          "conversations"
        ]
      },
      "post": {
        "operationId": "submit_message_api_v1_conversations__conversationId__messages_post",
        "parameters": [
          {
            "in": "path",
            "name": "conversationId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversationid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitMessageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Submit Message",
        "tags": [
          "conversations"
        ]
      }
    }
  }
}
