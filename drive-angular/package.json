{
  "name": "drive-advisor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build && node scripts/check-production-bundle.mjs",
    "test": "ng test --watch=false",
    "e2e": "playwright test",
    "e2e:visual": "playwright test e2e/visual --project=chromium",
    "e2e:responsive": "playwright test e2e/responsive",
    "check:bundle": "node scripts/check-production-bundle.mjs",
    "assets:home": "python -I tools/build-home-assets.py"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fontsource/heebo": "^5.2.8",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
