# Copy to .env for local development. Dummy values only - never commit real secrets.
STRAUSS_ENVIRONMENT=development
STRAUSS_DATABASE_URL=postgresql+psycopg://strauss:strauss_dev_only@localhost:55432/strauss
# Migration identity (architecture §3). Locally the same dev user; use a separate role elsewhere.
STRAUSS_MIGRATION_DATABASE_URL=postgresql+psycopg://strauss:strauss_dev_only@localhost:55432/strauss
# DB integration tests use a separate database whose name must end in _test.
STRAUSS_TEST_DATABASE_URL=postgresql+psycopg://strauss:strauss_dev_only@localhost:55432/strauss_test
STRAUSS_DB_PASSWORD=strauss_dev_only

# --- API: authentication, browser origins, worker, logging -----------------------------------
# HS256 signing secret for access tokens (at least 32 bytes). Required outside development/test;
# when empty locally, a random per-process secret is generated (tokens end at a restart).
STRAUSS_AUTH_TOKEN_SECRET=
# Browser origins of the Angular app, comma-separated. Refresh/logout accept only these
# (CSRF check); a non-empty list also enables CORS. Locally: the ng serve origins.
STRAUSS_AUTH_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Refresh cookie: Secure everywhere (browsers accept it on localhost too). SameSite=strict with
# the same-origin setup (ng serve proxy, Vercel rewrite); `none` only for a cross-site setup.
STRAUSS_AUTH_COOKIE_SECURE=true
STRAUSS_AUTH_COOKIE_SAMESITE=strict
# Run the AI turn worker and the Business-event relay inside the API process. Enable it on
# exactly one instance; without it conversations are accepted but never answered.
STRAUSS_WORKER_IN_PROCESS=true
# Application log level (codes and identifiers only; never secrets or salary data).
STRAUSS_LOG_LEVEL=INFO

# --- AI Engine LLM (free tier only) --------------------------------------------------------
# Leave STRAUSS_AI_LLM_PROFILES empty to run without an LLM (deterministic templates only).
# Each profile is one Google AI Studio project. Use projects WITHOUT a billing account:
# whether Gemini calls are free is decided by the project, so FREE_TIER_ACK=true is your
# confirmation that billing is disabled. Startup fails without it.
# The active profile is chosen explicitly; the app never switches profiles, models or
# providers on its own (not even when a quota is exhausted). Put real keys only in .env.
# Approved models: gemini-3.5-flash-lite (default), gemini-3.1-flash-lite,
# gemini-3.6-flash, gemini-3.8-flash. Check your project's limits in AI Studio.
STRAUSS_AI_LLM_PROFILES=
# e.g. STRAUSS_AI_LLM_PROFILES=dev,test and STRAUSS_AI_LLM_ACTIVE_PROFILE=dev
STRAUSS_AI_LLM_ACTIVE_PROFILE=dev

STRAUSS_AI_LLM_PROFILE_DEV_PROVIDER=gemini
STRAUSS_AI_LLM_PROFILE_DEV_MODEL=gemini-3.5-flash-lite
STRAUSS_AI_LLM_PROFILE_DEV_API_KEY=replace-with-your-free-tier-key
STRAUSS_AI_LLM_PROFILE_DEV_PROJECT_LABEL=strauss-dev
# Local ceilings, below the project's real free-tier limits (requests per minute / per day).
STRAUSS_AI_LLM_PROFILE_DEV_RPM_LIMIT=10
STRAUSS_AI_LLM_PROFILE_DEV_DAILY_REQUEST_LIMIT=200
STRAUSS_AI_LLM_PROFILE_DEV_TIMEOUT_SECONDS=20
STRAUSS_AI_LLM_PROFILE_DEV_FREE_TIER_ACK=false

STRAUSS_AI_LLM_PROFILE_TEST_PROVIDER=gemini
STRAUSS_AI_LLM_PROFILE_TEST_MODEL=gemini-3.5-flash-lite
STRAUSS_AI_LLM_PROFILE_TEST_API_KEY=replace-with-your-free-tier-key
STRAUSS_AI_LLM_PROFILE_TEST_PROJECT_LABEL=strauss-test
STRAUSS_AI_LLM_PROFILE_TEST_RPM_LIMIT=10
STRAUSS_AI_LLM_PROFILE_TEST_DAILY_REQUEST_LIMIT=200
STRAUSS_AI_LLM_PROFILE_TEST_TIMEOUT_SECONDS=20
STRAUSS_AI_LLM_PROFILE_TEST_FREE_TIER_ACK=false

# Optional live smoke test (one real request; skipped unless set to 1).
STRAUSS_AI_LIVE_LLM=0

# --- AI Engine database (schema `agent`, migrations: alembic -c alembic_ai.ini) -------------
# Same local database as Business; separate least-privilege roles to be agreed (D8).
STRAUSS_AI_DATABASE_URL=postgresql+psycopg://strauss:strauss_dev_only@localhost:55432/strauss
STRAUSS_AI_MIGRATION_DATABASE_URL=postgresql+psycopg://strauss:strauss_dev_only@localhost:55432/strauss
STRAUSS_AI_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
# AI persistence tests use their own database; the name must end in _test.
STRAUSS_AI_TEST_DATABASE_URL=postgresql+psycopg://strauss:strauss_dev_only@localhost:55432/strauss_ai_test
